# ---------------------------------------------------------------------------
# Firebase web configuration
# ---------------------------------------------------------------------------
# Copy this file to `.env` and paste in the values from your own Firebase project:
#   Firebase console -> Project settings -> General -> Your apps -> SDK setup and config
#
# These are NOT secrets. A Firebase web config is embedded in every client that talks to
# the project, and Google documents it as public information. What protects your data is
# `firestore.rules` and `storage.rules` — deploy those before going live.
#
# `.env` is gitignored so the repository stays tied to no particular project. For the
# GitHub Actions deploy, add each of these as a repository *secret* of the same name
# (Settings -> Secrets and variables -> Actions).
# ---------------------------------------------------------------------------

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# Deployment base path
# ---------------------------------------------------------------------------
# GitHub Pages project sites are served from https://<user>.github.io/<repo>/, so assets
# need that prefix. The deploy workflow sets this automatically from the repo name.
#
#   Project site  (github.io/math-tutoring)  ->  /math-tutoring/
#   User site     (username.github.io)       ->  /
#   Custom domain (tutoring.example.com)     ->  /
#
# Leave blank for local development.
VITE_BASE_PATH=
